{
  "name": "npu-ng",
  "version": "0.13.1",
  "description": "Neptun PowerUp! NG – felturbózza az új Neptun webes felületét",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:site": "node build.mjs --site && cp dist/npu.user.js site/npu.user.js",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:site && node test/run.mjs",
    "deploy": "wrangler deploy"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.127.1"
  }
}
